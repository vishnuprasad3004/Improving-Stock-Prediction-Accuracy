# ===== Application Configuration =====
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# ===== Cloudflare Configuration =====
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_KV_NAMESPACE_ID=your_kv_namespace_id_here

# ===== Database Configuration =====
DATABASE_URL=file:./data/app.db
DATABASE_DEBUG=false

# ===== API Keys =====
NSE_API_KEY=your_nse_api_key_here
BSE_API_KEY=your_bse_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here

# ===== Authentication =====
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here
JWT_EXPIRY=7d

# ===== Third-party Services =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@foursight.com

# ===== Feature Flags =====
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TIME_DATA=true
ENABLE_ADVANCED_CHARTS=true
ENABLE_SOCIAL_FEATURES=false

# ===== Logging =====
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_DATABASE_LOGGING=false

# ===== Rate Limiting =====
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ===== WebSocket =====
ENABLE_WEBSOCKET=true
WEBSOCKET_PING_INTERVAL=30000

# ===== Analytics =====
ENABLE_ANALYTICS=true
ANALYTICS_PROVIDER=google
GOOGLE_ANALYTICS_ID=your_ga_id_here

# ===== Sentry (Error Tracking) =====
ENABLE_ERROR_TRACKING=true
SENTRY_DSN=your_sentry_dsn_here

# ===== Cache Configuration =====
CACHE_STOCK_TTL=300
CACHE_PORTFOLIO_TTL=60
CACHE_WATCHLIST_TTL=300

# ===== File Upload =====
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,csv,xlsx,json

# ===== Email Configuration =====
SEND_WELCOME_EMAIL=true
SEND_TRADING_ALERTS=true
SEND_PORTFOLIO_REPORTS=true

# ===== Security =====
ENABLE_HTTPS=true
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_HELMET=true
